rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ====================== HELPER FUNCTIONS ======================

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function myUser() {
      return get(/databases/$(database)/documents/users/$(uid())).data;
    }

    function isAdmin() {
      return signedIn() && myUser().role == "admin";
    }

    function isManager() {
      return signedIn() && myUser().role == "manager";
    }

    function canManageEasterEggs() {
      return isAdmin() || isManager();
    }

    // Helper: allows a field to be either unchanged OR completely omitted in the update
    function unchangedOrMissing(field) {
      return !(field in request.resource.data) ||
             request.resource.data[field] == resource.data[field];
    }

    // Lead ownership checks
    function leadIsClaimedByMe() {
      return signedIn() && resource.data.claimedBy == uid();
    }

    // Disposition/door-knock-only updates allowed for any signed-in user.
    // Prevents ownership/assignment edits while allowing status saves across existing pins.
    function dispositionUpdateOnly() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
        'status',
        'disposition',
        'dispositionedAt',
        'dispositionHistory',
        'knockGpsLat',
        'knockGpsLng',
        'knockGpsAccuracy',
        'knockGpsTimestamp',
        'knockDistanceFromAddress'
      ]);
    }

    function leadIsAssignedToMe() {
      return signedIn() && resource.data.assignedTo == uid();
    }

    function leadIsManualByMe() {
      return signedIn()
        && resource.data.source == "manually-added"
        && resource.data.setterId == uid();
    }

    function requestIsManualByMe() {
      return signedIn()
        && request.resource.data.source == "manually-added"
        && request.resource.data.setterId == uid();
    }

    // Allow first-time claim transition: unowned lead -> claimed by current user.
    function claimTransitionByMe() {
      return signedIn()
        && (
          !("claimedBy" in resource.data)
          || resource.data.claimedBy == null
          || resource.data.claimedBy == ""
        )
        && request.resource.data.claimedBy == uid()
        && unchangedOrMissing("assignedTo")
        && unchangedOrMissing("territoryId")
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          "claimedBy",
          "claimedAt",
          "status"
        ]);
    }

    function easterEggLeadPlacementUpdate() {
      return canManageEasterEggs()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          "hasEasterEgg",
          "easterEggId"
        ])
        && request.resource.data.hasEasterEgg == true
        && ("easterEggId" in request.resource.data)
        && request.resource.data.easterEggId != null;
    }

    function easterEggLeadClearUpdate() {
      return signedIn()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          "hasEasterEgg",
          "easterEggId"
        ])
        && resource.data.hasEasterEgg == true
        && (
          !("hasEasterEgg" in request.resource.data)
          || request.resource.data.hasEasterEgg == false
        )
        && (
          !("easterEggId" in request.resource.data)
          || request.resource.data.easterEggId == null
        );
    }

    function easterEggWinUpdateOnly() {
      return signedIn()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          "wonBy",
          "currentWinners",
          "active"
        ]);
    }

    // ====================== USERS ======================
    // Any signed-in user can read (supports UI: names, colors, dropdowns, etc.)
    // Only admins can create/update/delete users
    match /users/{userId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // ====================== DISPOSITIONS ======================
    // All signed-in users can read dispositions (for labels, dropdowns, analytics)
    // Only admins can modify
    match /dispositions/{dispositionId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // ====================== ADMIN SETTINGS ======================
    // Any signed-in user can READ global admin settings (needed for client-side flows like
    // "Send info to Scheduling Manager" to fetch the webhook URL).
    // Writes are intentionally server-only via Admin SDK (e.g. /api/admin/settings).
    match /adminSettings/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // ====================== USER SESSIONS ======================
    // Simple per-user client session storage (used for UI state / onboarding)
    // Doc id is Firebase Auth UID (see app/utils/auth.ts + app/utils/userSession.ts)
    match /userSessions/{docId} {
      allow read, write: if signedIn() && docId == uid();
    }

    // ====================== USER GOALS ======================
    // Users can read only their own goals; admins can read all.
    // Writes are admin-only (preferably via Admin SDK route).
    match /userGoals/{docId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == uid());
      allow create, update, delete: if isAdmin();
    }

    // ====================== TERRITORIES ======================
    // Admins see everything; reps can only read their own assigned territory
    match /territories/{territoryId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == uid());
      allow create, update, delete: if isAdmin();
    }

    // ====================== EASTER EGGS ======================
    // Signed-in users can read active egg state and record wins.
    // Admins/managers can fully manage eggs from the admin page.
    match /easterEggs/{eggId} {
      allow read: if signedIn();
      allow create, delete: if canManageEasterEggs();
      allow update: if canManageEasterEggs() || easterEggWinUpdateOnly();
    }

    // ====================== LEADS ======================
    match /leads/{leadId} {

      // READ: Admins/managers = all; reps = only their claimed / assigned / manually-created leads
      // This must stay aligned with canSeeAllLeads() in app/types/index.ts.
      allow read: if isAdmin()
        || isManager()
        || leadIsClaimedByMe()
        || leadIsAssignedToMe()
        || leadIsManualByMe();

      // CREATE: Admins = anything; reps = only manual leads they set themselves
      allow create: if isAdmin() || requestIsManualByMe();

      // UPDATE:
      //   Admins = anything
      //   Reps on owned leads = normal updates (no ownership/assignment mutations)
      //   Any signed-in user = disposition/door-knock-only updates (no ownership/assignment mutations)
      allow update: if isAdmin() || easterEggLeadPlacementUpdate() || easterEggLeadClearUpdate() || (
        (leadIsClaimedByMe() || leadIsAssignedToMe() || leadIsManualByMe())
        && unchangedOrMissing("claimedBy")
        && unchangedOrMissing("assignedTo")
        && unchangedOrMissing("territoryId")
      ) || (
        signedIn()
        && dispositionUpdateOnly()
        && unchangedOrMissing("claimedBy")
        && unchangedOrMissing("assignedTo")
        && unchangedOrMissing("territoryId")
      ) || claimTransitionByMe();

      // DELETE: admin only
      allow delete: if isAdmin();
    }

    // ====================== DISPOSITION HISTORY ======================
    match /disposition_history/{id} {
      allow read: if isAdmin();
      allow create: if signedIn() && request.resource.data.userId == uid();
      allow update, delete: if isAdmin();
    }

    // ====================== HOMEOWNERS (Raydar mobile v12.2) ======================
    // Read-only public-record homeowner data for map pins. Any signed-in, active,
    // approved admin/manager/setter/closer may run bounded list queries (limit <= 500).
    // No territory or per-user flag. No client get/create/update/delete (Admin SDK only).
    match /homeowners/{homeownerId} {
      function activeHomeownerReader() {
        let user = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
        return user.role in ['admin', 'manager', 'setter', 'closer']
          && user.get('isActive', true) != false
          && user.get('approved', true) != false
          && user.get('approvalStatus', 'approved') == 'approved'
          && user.get('status', 'active') == 'active'
          && user.get('deleted', false) != true
          && user.get('deletedAt', null) == null
          && user.get('deletionPending', false) != true;
      }
      allow list: if request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.query.limit != null
        && request.query.limit <= 500
        && activeHomeownerReader();
      allow get, create, update, delete: if false;
    }

    // ====================== DEFAULT DENY (critical security rule) ======================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
