rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ====================== HELPER FUNCTIONS ======================

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function notAnonymous() {
      return request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // One get() per call. Call only after hasProfile(); a missing doc errors
    // and the rule denies, which is the same outcome as a false predicate.
    function profileApprovedActive() {
      let user = me();
      return user.role in ['admin', 'manager', 'setter', 'closer']
        && user.get('isActive', true) != false
        && user.get('approved', true) != false
        && user.get('approvalStatus', 'approved') == 'approved'
        && user.get('status', 'active') == 'active'          // blocks 'deletion-requested', 'pending', deactivated
        && user.get('deleted', false) != true
        && user.get('deletedAt', null) == null
        && user.get('deletionPending', false) != true;
    }

    // Same field defaults as the deployed homeowners predicate, which already
    // works for real reps. Missing flags stay allowed so legacy docs pass.
    function approvedActive() {
      return hasProfile() && notAnonymous() && profileApprovedActive();
    }

    function isTest() {
      let user = me();
      return user.get('isTestAccount', false) == true
        || user.get('testData', false) == true
        || user.get('team', '') == 'TEST';
    }

    // AND form of !isTest(). Keeps claim/knock rules under the expression budget.
    function notTest() {
      let user = me();
      return user.get('isTestAccount', false) != true
        && user.get('testData', false) != true
        && user.get('team', '') != 'TEST';
    }

    function isAdmin() {
      return hasProfile() && notAnonymous() && me().role == 'admin' && profileApprovedActive();
    }

    function isManager() {
      return hasProfile() && notAnonymous() && me().role == 'manager' && profileApprovedActive();
    }

    function isStaff() {
      return (isAdmin() || isManager()) && !isTest();
    }

    // Any approved active role, including setter and closer.
    function isRep() {
      return approvedActive();
    }

    function canManageEasterEggs() {
      return isAdmin() || isManager();
    }

    // Helper: allows a field to be either unchanged OR completely omitted in the update
    function unchangedOrMissing(field) {
      return !(field in request.resource.data) ||
             request.resource.data[field] == resource.data[field];
    }

    // Lead ownership checks
    function leadIsClaimedByMe() {
      return signedIn() && resource.data.claimedBy == uid();
    }

    // Disposition/door-knock-only updates.
    // Prevents ownership/assignment edits while allowing status saves across existing pins.
    // affectedKeys() = added + removed + changed. Equal values are not affected, so a
    // client that resubmits unchanged contact fields is judged only on keys that
    // actually change. changedKeys() alone let a knock ADD or DELETE any other field
    // (for example delete claimedBy, or add setterId/source).
    function dispositionUpdateOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'status',
        'disposition',
        'dispositionedAt',
        'dispositionHistory',
        'knockGpsLat',
        'knockGpsLng',
        'knockGpsAccuracy',
        'knockGpsTimestamp',
        'knockDistanceFromAddress',
        'gpsVerified',
        'gpsUnverifiedReason',
        'gpsDistanceM',
        'objectionType',
        'objectionNotes',
        'objectionRecordedAt',
        'objectionRecordedBy',
        'goBackScheduledDate',
        'goBackScheduledTime',
        'goBackNotes',
        'goBackScheduledBy',
        'notes'
      ]) && dispoExtrasValid();
    }

    // notes: on a non-owned lead, this check allows notes only when the doc has
    // no notes key, as a string of at most 10000 characters. Overwrite fails here.
    // Deleting notes is contactClearsValid, not this function. Owners use ownerLeadUpdate.
    function dispoNotesValid() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['notes'])
        || (request.resource.data.get('notes', null) is string
            && request.resource.data.notes.size() <= 10000
            && !('notes' in resource.data));
    }

    // Contact fields the scheduling-manager editor saves. Add-only when the key is
    // absent (filling a missing field). Resubmitted equal values are not in
    // affectedKeys(), so 14.17 can send all nine fields and only the real change
    // is checked. Overwrite stays denied. Deletes of phone, email, estimatedBill,
    // and notes are contactClearsValid.
    // Bounds: name <= 200, address <= 300, city <= 100, state <= 32, zip <= 16,
    // phone <= 40, email <= 254, estimatedBill number 0 through 100000.
    function contactFillsValid() {
      let k = request.resource.data.diff(resource.data).affectedKeys();
      let d = request.resource.data;
      return addedContactString(k, d, 'name', 200)
        && addedContactString(k, d, 'address', 300)
        && addedContactString(k, d, 'city', 100)
        && addedContactString(k, d, 'state', 32)
        && addedContactString(k, d, 'zip', 16)
        && addedContactString(k, d, 'phone', 40)
        && addedContactString(k, d, 'email', 254)
        && addedContactBill(k, d);
    }

    function addedContactString(k, d, field, max) {
      return !k.hasAny([field])
        || (
          !(field in resource.data)
          && (field in d)
          && d[field] is string
          && d[field].size() <= max
        );
    }

    function addedContactBill(k, d) {
      return !k.hasAny(['estimatedBill'])
        || (
          !('estimatedBill' in resource.data)
          && ('estimatedBill' in d)
          && d.estimatedBill is number
          && d.estimatedBill >= 0
          && d.estimatedBill <= 100000
        );
    }

    // Photos from LeadDetail.handleAddPhoto / the 14.17 direct outbox.
    // The write's affected keys are exactly ['photos']: the previous list plus
    // one item {id, url, caption, type, uploadedBy, uploadedAt}.
    // Cap is 50. Kept off dispositionUpdateOnly so the prefix check is not
    // evaluated on ordinary knocks (rules expression budget).
    // Same writers as notes: staff (admin/manager, not TEST) or the territory
    // owner. Owners use ownerLeadUpdate and are not limited to appends.
    // A Storage-host allowlist is possible with matches(), but this shared path
    // submits whatever URL string the caller has (the web field is free text),
    // so the url bound is length only: 1 through 2048 characters.
    function photoAppendUpdate() {
      let k = request.resource.data.diff(resource.data).affectedKeys();
      return k.hasOnly(['photos'])
        && k.hasAny(['photos'])
        && photoListAppendOk()
        && addsNoOwnership(['claimedBy', 'assignedTo', 'territoryId'])
        && photoAudience()
        && approvedActive();
    }

    function photoAudience() {
      let user = me();
      return ((user.role == 'admin' || user.role == 'manager') && notTest())
        || leadInMyTerritory();
    }

    function photoListAppendOk() {
      let old = resource.data.get('photos', []);
      let neu = request.resource.data.get('photos', null);
      return neu is list
        && old is list
        && neu.size() == old.size() + 1
        && neu.size() <= 50
        && (old.size() == 0 || photoPrefixUnchanged(old, neu))
        && newPhotoOk(neu[neu.size() - 1]);
    }

    // Rules have no loops or slices. Comparing every stored id on top of hasAll
    // exceeds the 1000-expression budget once a lead already has 49 photos.
    // Lists of 16 or fewer check the id at every index. Longer lists check
    // index 0 and indexes 16 through the last stored photo, and hasAll still
    // requires every stored map to be present, so a caption/url/type edit fails.
    // A reorder that only touches indexes 1-15 of a longer list can pass.
    function photoPrefixUnchanged(old, neu) {
      let n = old.size();
      return (n <= 16 && photoIdPrefix16(old, neu, n))
        || (n > 16 && neu.hasAll(old) && photoIdPrefixFrom16(old, neu, n));
    }

    function photoIdPrefixFrom16(old, neu, n) {
      return neu[0].id == old[0].id
        && neu[n - 1].id == old[n - 1].id
        && (n < 17 || neu[16].id == old[16].id)
        && (n < 18 || neu[17].id == old[17].id)
        && (n < 19 || neu[18].id == old[18].id)
        && (n < 20 || neu[19].id == old[19].id)
        && (n < 21 || neu[20].id == old[20].id)
        && (n < 22 || neu[21].id == old[21].id)
        && (n < 23 || neu[22].id == old[22].id)
        && (n < 24 || neu[23].id == old[23].id)
        && (n < 25 || neu[24].id == old[24].id)
        && (n < 26 || neu[25].id == old[25].id)
        && (n < 27 || neu[26].id == old[26].id)
        && (n < 28 || neu[27].id == old[27].id)
        && (n < 29 || neu[28].id == old[28].id)
        && (n < 30 || neu[29].id == old[29].id)
        && (n < 31 || neu[30].id == old[30].id)
        && (n < 32 || neu[31].id == old[31].id)
        && (n < 33 || neu[32].id == old[32].id)
        && (n < 34 || neu[33].id == old[33].id)
        && (n < 35 || neu[34].id == old[34].id)
        && (n < 36 || neu[35].id == old[35].id)
        && (n < 37 || neu[36].id == old[36].id)
        && (n < 38 || neu[37].id == old[37].id)
        && (n < 39 || neu[38].id == old[38].id)
        && (n < 40 || neu[39].id == old[39].id)
        && (n < 41 || neu[40].id == old[40].id)
        && (n < 42 || neu[41].id == old[41].id)
        && (n < 43 || neu[42].id == old[42].id)
        && (n < 44 || neu[43].id == old[43].id)
        && (n < 45 || neu[44].id == old[44].id)
        && (n < 46 || neu[45].id == old[45].id)
        && (n < 47 || neu[46].id == old[46].id)
        && (n < 48 || neu[47].id == old[47].id)
        && (n < 49 || neu[48].id == old[48].id);
    }

    function photoIdPrefix16(old, neu, n) {
      return neu.hasAll(old)
        && (n < 1 || neu[0].id == old[0].id)
        && (n < 2 || neu[1].id == old[1].id)
        && (n < 3 || neu[2].id == old[2].id)
        && (n < 4 || neu[3].id == old[3].id)
        && (n < 5 || neu[4].id == old[4].id)
        && (n < 6 || neu[5].id == old[5].id)
        && (n < 7 || neu[6].id == old[6].id)
        && (n < 8 || neu[7].id == old[7].id)
        && (n < 9 || neu[8].id == old[8].id)
        && (n < 10 || neu[9].id == old[9].id)
        && (n < 11 || neu[10].id == old[10].id)
        && (n < 12 || neu[11].id == old[11].id)
        && (n < 13 || neu[12].id == old[12].id)
        && (n < 14 || neu[13].id == old[13].id)
        && (n < 15 || neu[14].id == old[14].id)
        && (n < 16 || neu[15].id == old[15].id);
    }

    function newPhotoOk(photo) {
      return photo is map
        && photo.keys().hasAll(['id', 'url', 'caption', 'type', 'uploadedBy', 'uploadedAt'])
        && photo.keys().hasOnly(['id', 'url', 'caption', 'type', 'uploadedBy', 'uploadedAt'])
        && photo.id is string
        && photo.id.matches('^[0-9]{10,16}-[0-9a-z]{1,9}$')
        && photo.url is string
        && photo.url.size() > 0
        && photo.url.size() <= 2048
        && photo.caption is string
        && photo.caption.size() <= 500
        && photo.type is string
        && photo.type in ['roof', 'meter', 'electrical', 'roofing', 'other']
        && photo.uploadedBy == request.auth.uid
        && photo.uploadedAt is timestamp;
    }

    // GPS never blocks a disposition. The three gps* keys are optional.
    // Nothing here requires knockGps* or knockDistanceFromAddress, and nothing
    // compares them to a 50m (or any other) distance or accuracy limit.
    // When a knock number is in the write, it must be finite and in range:
    // lat -90..90, lng -180..180, accuracy and knockDistanceFromAddress 0..1e6.
    // gpsDistanceM, when present, is a number from 0 through 100000.
    // get(field, validDefault) treats a deleted flag as valid, so a re-knock
    // can clear it with deleteField(). A present value still has to match.
    // Explicit null fails these checks for territory and staff writers.
    // An owner can also write null, via ownerGpsOk.
    function gpsFlagsOk(k, d) {
      return (!k.hasAny(['gpsVerified']) || d.get('gpsVerified', true) is bool)
        // Clients send other only for a usable fix whose lead has no coordinates.
        && (!k.hasAny(['gpsUnverifiedReason']) || d.get('gpsUnverifiedReason', 'no_fix') in [
          'no_fix', 'stale', 'low_accuracy', 'reduced_accuracy', 'too_far', 'out_of_area', 'other'
        ])
        && (!k.hasAny(['gpsDistanceM']) || (
          d.get('gpsDistanceM', 0) >= 0 && d.get('gpsDistanceM', 0) <= 100000
        ));
    }

    function dispoGpsValid(k, d) {
      return !k.hasAny([
          'gpsVerified', 'gpsUnverifiedReason', 'gpsDistanceM',
          'knockGpsLat', 'knockGpsLng', 'knockGpsAccuracy', 'knockDistanceFromAddress'
        ])
        || (
          gpsFlagsOk(k, d)
          && knockNumberOk(k, d, 'knockGpsLat', -90, 90)
          && knockNumberOk(k, d, 'knockGpsLng', -180, 180)
          && knockNumberOk(k, d, 'knockGpsAccuracy', 0, 1000000)
          && knockNumberOk(k, d, 'knockDistanceFromAddress', 0, 1000000)
        );
    }

    // min/max reject NaN and the infinities: those comparisons are false.
    function knockNumberOk(k, d, field, min, max) {
      return !k.hasAny([field])
        || (d[field] is number && d[field] >= min && d[field] <= max);
    }

    // Only keys this write touches are checked, so legacy values elsewhere
    // never block a knock. null/removed clears a field (follow-up clear writes
    // goBackScheduledDate null and goBackScheduledTime '').
    function dispoExtrasValid() {
      let d = request.resource.data;
      let k = request.resource.data.diff(resource.data).affectedKeys();
      return (!k.hasAny(['notes'])
          || (d.get('notes', null) is string && d.notes.size() <= 10000 && !('notes' in resource.data)))
        && dispoGpsValid(k, d)
        && (!k.hasAny(['objectionType', 'objectionNotes', 'objectionRecordedAt', 'objectionRecordedBy'])
          || (
            (!k.hasAny(['objectionType']) || d.get('objectionType', null) == null
              || d.objectionType in ['too-expensive', 'bad-credit', 'roof-issues', 'moving-soon', 'not-owner',
                                     'already-has-solar', 'too-complicated', 'need-to-think',
                                     'not-interested-in-solar', 'other'])
            && (!k.hasAny(['objectionNotes']) || d.get('objectionNotes', null) == null
              || (d.objectionNotes is string && d.objectionNotes.size() <= 10000))
            && (!k.hasAny(['objectionRecordedAt']) || d.get('objectionRecordedAt', null) == null
              || d.objectionRecordedAt is timestamp)
            && (!k.hasAny(['objectionRecordedBy']) || d.get('objectionRecordedBy', null) == null
              || d.objectionRecordedBy == request.auth.uid)
          ))
        && (!k.hasAny(['goBackScheduledDate', 'goBackScheduledTime', 'goBackNotes', 'goBackScheduledBy'])
          || (
            (!k.hasAny(['goBackScheduledDate']) || d.get('goBackScheduledDate', null) == null
              || d.goBackScheduledDate is timestamp)
            && (!k.hasAny(['goBackScheduledTime']) || d.get('goBackScheduledTime', null) == null
              || (d.goBackScheduledTime is string && d.goBackScheduledTime.size() <= 16))
            && (!k.hasAny(['goBackNotes']) || d.get('goBackNotes', null) == null
              || (d.goBackNotes is string && d.goBackNotes.size() <= 10000))
            && (!k.hasAny(['goBackScheduledBy']) || d.get('goBackScheduledBy', null) == null
              || d.goBackScheduledBy == request.auth.uid)
          ));
    }

    // changedKeys() ignores keys the write ADDS. Block adding ownership fields,
    // matching the deployed unchangedOrMissing() guards on these branches.
    function addsNoOwnership(fields) {
      return !request.resource.data.diff(resource.data).addedKeys().hasAny(fields);
    }

    function leadIsAssignedToMe() {
      return signedIn() && resource.data.assignedTo == uid();
    }

    function leadIsManualByMe() {
      return signedIn()
        && resource.data.source == "manually-added"
        && resource.data.setterId == uid();
    }

    function requestIsManualByMe() {
      return signedIn()
        && request.resource.data.source == "manually-added"
        && request.resource.data.setterId == uid();
    }

    // App Review territory id is TEST-appreview-territory. That id prefix is
    // what marks a territory TEST. Owner is userId, the same field
    // leadInMyTerritory() reads. source stays manually-added so this create
    // is still inside the deployed rules.
    function testAccountTestLeadCreate() {
      return request.resource.data.testData == true
        && request.resource.data.claimedBy == uid()
        && request.resource.data.setterId == uid()
        && request.resource.data.source == "manually-added"
        && request.resource.data.territoryId is string
        && request.resource.data.territoryId.matches('^TEST-.*')
        && (
          !("assignedTo" in request.resource.data)
          || request.resource.data.assignedTo == uid()
        )
        && request.resource.data.get('hasEasterEgg', false) != true
        && approvedActive()
        && isTest()
        && get(/databases/$(database)/documents/territories/$(request.resource.data.territoryId)).data.userId == uid();
    }

    // Web knocks on pins inside the rep's territory polygon are not always
    // assigned to that rep. territoryId must be set on those leads.
    function leadInMyTerritory() {
      return resource.data.get('territoryId', null) != null
        && get(/databases/$(database)/documents/territories/$(resource.data.territoryId)).data.userId == request.auth.uid;
    }

    // Allow first-time claim transition: unowned lead -> claimed by current user.
    // Demo does not need this path.
    function claimTransitionByMe() {
      // Cheap rejects first. Diff plus the profile checks blow the rules
      // expression budget when every other update branch evaluates them too.
      return request.resource.data.get('claimedBy', '') == uid()
        && (
          !("claimedBy" in resource.data)
          || resource.data.get('claimedBy', null) == null
          || resource.data.get('claimedBy', '') == ''
        )
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          "claimedBy",
          "claimedAt",
          "status"
        ])
        && addsNoOwnership(['assignedTo', 'territoryId'])
        && approvedActive()
        && notTest();
    }

    // App Review claim/unclaim. Every condition is required together.
    // Claim: claimedBy goes from absent/null/empty to uid().
    // Unclaim: claimedBy goes from uid() to absent/null.
    // Same changed fields as claimTransitionByMe. testData stays true.
    function testAccountClaimOrUnclaim() {
      let territoryId = resource.data.get('territoryId', '');
      return resource.data.get('testData', false) == true
        && resource.data.get('assignedTo', '') == uid()
        && territoryId is string
        && territoryId.matches('^TEST-.*')
        && request.resource.data.get('testData', false) == true
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          "claimedBy",
          "claimedAt",
          "status"
        ])
        && addsNoOwnership(['assignedTo', 'territoryId'])
        && (
          (
            request.resource.data.get('claimedBy', '') == uid()
            && (
              !("claimedBy" in resource.data)
              || resource.data.get('claimedBy', null) == null
              || resource.data.get('claimedBy', '') == ''
            )
          )
          || (
            resource.data.get('claimedBy', '') == uid()
            && (
              !("claimedBy" in request.resource.data)
              || request.resource.data.claimedBy == null
            )
          )
        )
        && isTest()
        && approvedActive()
        && get(/databases/$(database)/documents/territories/$(territoryId)).data.userId == uid();
    }

    // Approved owners, including the demo, may edit a lead they already own
    // without changing claim, assignment, or territory.
    function ownerLeadUpdate() {
      return (leadIsClaimedByMe() || leadIsAssignedToMe() || leadIsManualByMe())
        && unchangedOrMissing("claimedBy")
        && unchangedOrMissing("assignedTo")
        && unchangedOrMissing("territoryId")
        && approvedActive()
        && ownerGpsOk();
    }

    // Editor fills are their own allow, after dispositions. A knock that already
    // matched does not evaluate these checks. The 1000-expression limit is one
    // shared budget for every allow update in the request.
    // Clears match live changedKeys(): a removal is not a changed key, so a
    // manager (not a TEST account) or the territory owner, including the demo
    // on a pin in their territory, can deleteField phone, email, estimatedBill,
    // or notes on a lead they do not own. Any other key, including photos and
    // name, still fails. Explicit null is not a removal.
    function contactClearsValid(k, d) {
      return k.hasAny(['phone', 'email', 'estimatedBill', 'notes'])
        && k.hasOnly(['phone', 'email', 'estimatedBill', 'notes'])
        && (!k.hasAny(['phone']) || !('phone' in d))
        && (!k.hasAny(['email']) || !('email' in d))
        && (!k.hasAny(['estimatedBill']) || !('estimatedBill' in d))
        && (!k.hasAny(['notes']) || !('notes' in d));
    }

    function contactFillUpdate() {
      let k = request.resource.data.diff(resource.data).affectedKeys();
      let d = request.resource.data;
      return (
          (
            k.hasAny(['name', 'address', 'city', 'state', 'zip', 'phone', 'email', 'estimatedBill', 'notes'])
            && k.hasOnly(['name', 'address', 'city', 'state', 'zip', 'phone', 'email', 'estimatedBill', 'notes'])
            && contactFillsValid()
            && dispoNotesValid()
          )
          || contactClearsValid(k, d)
        )
        && addsNoOwnership(['claimedBy', 'assignedTo', 'territoryId'])
        && photoAudience()
        && approvedActive();
    }

    // Door knocks are a separate allow. The expression limit is still shared.
    // Owners are covered by ownerLeadUpdate, which already allows these fields.
    function staffDisposition() {
      let user = me();
      return (user.role == 'admin' || user.role == 'manager')
        && notTest()
        && dispositionUpdateOnly()
        && addsNoOwnership(['claimedBy', 'assignedTo', 'territoryId'])
        && approvedActive();
    }

    // Territory owners, including the demo, can knock pins in their territory.
    // addedKeys blocks ownership fields that changedKeys() does not see.
    function territoryDisposition() {
      return leadInMyTerritory()
        && dispositionUpdateOnly()
        && addsNoOwnership(['claimedBy', 'assignedTo', 'territoryId'])
        && approvedActive();
    }

    // Only evaluated for an owner. Missing or null clears a stale gps* flag.
    function ownerGpsOk() {
      let k = request.resource.data.diff(resource.data).affectedKeys();
      let d = request.resource.data;
      return (!k.hasAny(['gpsVerified']) || !('gpsVerified' in d) || d.gpsVerified == null || d.gpsVerified is bool)
        && (!k.hasAny(['gpsUnverifiedReason']) || !('gpsUnverifiedReason' in d) || d.gpsUnverifiedReason == null || (
          d.gpsUnverifiedReason is string
          && d.gpsUnverifiedReason in [
            'no_fix', 'stale', 'low_accuracy', 'reduced_accuracy', 'too_far', 'out_of_area', 'other'
          ]
        ))
        && (!k.hasAny(['gpsDistanceM']) || !('gpsDistanceM' in d) || d.gpsDistanceM == null || (
          d.gpsDistanceM is number && d.gpsDistanceM >= 0 && d.gpsDistanceM <= 100000
        ));
    }

    function easterEggLeadPlacementUpdate() {
      return request.resource.data.get('hasEasterEgg', false) == true
        && ("easterEggId" in request.resource.data)
        && request.resource.data.easterEggId != null
        && canManageEasterEggs()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          "hasEasterEgg",
          "easterEggId"
        ]);
    }

    function easterEggLeadClearUpdate() {
      return resource.data.get('hasEasterEgg', false) == true
        && approvedActive()
        && notTest()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          "hasEasterEgg",
          "easterEggId"
        ])
        && (
          !("hasEasterEgg" in request.resource.data)
          || request.resource.data.hasEasterEgg == false
        )
        && (
          !("easterEggId" in request.resource.data)
          || request.resource.data.easterEggId == null
        );
    }

    function easterEggWinUpdateOnly() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
        "wonBy",
        "currentWinners",
        "active"
      ]);
    }

    // ====================== USERS ======================
    // Own doc stays readable so pending-approval routing and the deletion
    // notice keep working. Staff can read the directory. Phase 1 also lets
    // real reps list it for installed Raydar <=14.14 and web name/color lookups.
    // Self-signups, inactive, deletion-requested, and the App Review TEST
    // account cannot list or read other users.
    match /users/{userId} {
      allow get: if signedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && userId == request.auth.uid;
      allow get, list: if isStaff();
      // TODO(phase 2): drop this once GET /api/users/directory ships in web +
      // native and installed builds have updated.
      allow get, list: if isRep() && !isTest();
      allow create, update, delete: if isAdmin();
    }

    // ====================== DISPOSITIONS ======================
    // Approved active users can read dispositions (the demo needs labels).
    // Only admins can modify.
    match /dispositions/{dispositionId} {
      allow read: if approvedActive();
      allow create, update, delete: if isAdmin();
    }

    // ====================== ADMIN SETTINGS ======================
    // Phase 1: real reps still read the scheduling webhook. Self-signups and
    // the demo cannot. Writes stay server-only.
    // Phase 2 (separate PR): /api/scheduling-handoff, then admin-only read.
    match /adminSettings/{docId} {
      allow read: if approvedActive() && !isTest();
      allow write: if false;
    }

    // ====================== USER SESSIONS ======================
    // Own doc only. Anonymous tokens are denied with everything else.
    match /userSessions/{docId} {
      allow read, write: if signedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && docId == uid();
    }

    // ====================== USER GOALS ======================
    // Users can read only their own goals; admins can read all.
    // Writes are admin-only (preferably via Admin SDK route).
    match /userGoals/{docId} {
      allow read: if isAdmin() || (
        signedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && resource.data.uid == uid()
      );
      allow create, update, delete: if isAdmin();
    }

    // ====================== TERRITORIES ======================
    // Admins see everything; reps can only read their own assigned territory.
    // Managers are not added. Own branch now requires an approved active profile.
    match /territories/{territoryId} {
      allow read: if isAdmin() || (approvedActive() && resource.data.userId == uid());
      allow create, update, delete: if isAdmin();
    }

    // ====================== EASTER EGGS ======================
    // Real approved users can read active egg state and record wins.
    // The demo cannot. Admins/managers can fully manage eggs.
    match /easterEggs/{eggId} {
      allow read: if approvedActive() && !isTest();
      allow create, delete: if canManageEasterEggs();
      allow update: if canManageEasterEggs() || (approvedActive() && !isTest() && easterEggWinUpdateOnly());
    }

    // ====================== LEADS ======================
    match /leads/{leadId} {

      // READ: Admins/managers = all (active only); reps = claimed / assigned / manual.
      // The demo still reads leads assigned to it. This stays aligned with
      // canSeeAllLeads() in app/types/index.ts.
      allow read: if isAdmin()
        || isManager()
        || (
          approvedActive()
          && (leadIsClaimedByMe() || leadIsAssignedToMe() || leadIsManualByMe())
        );

      // CREATE: Admins = anything; real reps = only manual leads they set themselves.
      // TEST accounts get a separate branch for a test-only lead in their own
      // TEST territory, and nothing else.
      allow create: if isAdmin();
      allow create: if approvedActive() && !isTest() && requestIsManualByMe();
      allow create: if testAccountTestLeadCreate();

      // UPDATE: the 1000-expression limit is one budget for the whole request.
      // A branch that returns false still spends the expressions it evaluated.
      //   Admins = anything
      //   Managers = easter-egg placement
      //   Real reps clear an egg they can see
      //   Approved owners (including the demo) = normal updates without ownership edits
      //   Staff or the territory owner = disposition/door-knock only
      //   Contact fills, and deletes of phone, email, estimatedBill, or notes,
      //   are the editor's keys only, after a disposition misses
      //   Real reps = first claim
      //   TEST accounts = claim or unclaim only their assigned testData lead
      //   in a TEST territory they own
      // Photo append is first so a non-photo write fails hasOnly(['photos'])
      // before the prefix check runs. That does not reset the budget.
      allow update: if photoAppendUpdate();
      allow update: if isAdmin();
      allow update: if ownerLeadUpdate();
      allow update: if staffDisposition();
      allow update: if territoryDisposition();
      // After a disposition match these are not evaluated, which keeps the
      // shared expression budget for the knock itself.
      allow update: if easterEggLeadPlacementUpdate();
      allow update: if easterEggLeadClearUpdate();
      allow update: if contactFillUpdate();
      allow update: if claimTransitionByMe();
      allow update: if testAccountClaimOrUnclaim();

      // DELETE: admin only
      allow delete: if isAdmin();
    }

    // ====================== DISPOSITION HISTORY ======================
    match /disposition_history/{id} {
      allow read: if isAdmin();
      allow create: if approvedActive() && request.resource.data.userId == uid();
      allow update, delete: if isAdmin();
    }

    // ====================== HOMEOWNERS (Raydar mobile v12.2) ======================
    // Read-only public-record homeowner data for map pins. Bounded list only.
    // Deployed activeHomeownerReader, plus an explicit profile and a TEST deny.
    // The emulator exposes request.query.orderBy as a map of field to ASC/DESC
    // (plus implicit __name__). Mobile source.ts always orderBy('geohash').
    match /homeowners/{homeownerId} {
      function activeHomeownerReader() {
        let user = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
        return user.role in ['admin', 'manager', 'setter', 'closer']
          && user.get('isActive', true) != false
          && user.get('approved', true) != false
          && user.get('approvalStatus', 'approved') == 'approved'
          && user.get('status', 'active') == 'active'
          && user.get('deleted', false) != true
          && user.get('deletedAt', null) == null
          && user.get('deletionPending', false) != true;
      }
      allow list: if request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.query.limit != null
        && request.query.limit <= 500
        && request.query.orderBy['geohash'] == 'ASC'
        && hasProfile()
        && !isTest()
        && activeHomeownerReader();
      allow get, create, update, delete: if false;
    }

    // ====================== DEFAULT DENY (critical security rule) ======================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
