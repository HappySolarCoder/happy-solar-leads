# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Hot-lead import sidecars. Addresses must not be committed.
*.geocode-cache.json
*.needs-review.csv

.vercel

# Scratch scripts and pages that hardcoded a Google API key (leaked Feb 2026). Never commit these;
# read keys from process.env.GOOGLE_API_KEY instead.
/test-solar-api-fields.js
/test-route.js
/test-solar.html
/debug-console.html
/quick-test.html
/react-path-test.html
/simple-test.html
/test-upload.html
/upload-diagnostic.html
