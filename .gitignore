# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# Native build staging and signing material
/.mobile-build/
*.jks
*.keystore
*.p12
*.mobileprovision
!mobile.env.example

# Recreated from resources/raydar-v5/logo.svg by mobile:build
/android/app/src/main/res/**/*.png
/ios/App/App/Assets.xcassets/**/*.png
