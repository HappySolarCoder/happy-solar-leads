{
  "name": "raydar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "playwright test",
    "test:report": "playwright show-report",
    "setup-test": "node scripts/reset-data.js; node scripts/generate-test-users.js; node scripts/generate-test-leads.js",
    "test-assign": "node scripts/test-autoassign.js",
    "reset": "node scripts/reset-data.js",
    "gen-leads": "node scripts/generate-test-leads.js",
    "gen-users": "node scripts/generate-test-users.js",
    "mobile:build": "node scripts/mobile/build.mjs && npm run mobile:assets",
    "mobile:sync": "cap sync",
    "mobile:ios": "npm run mobile:build && cap sync ios && cap open ios",
    "mobile:android": "npm run mobile:build && cap sync android && cap open android",
    "mobile:check-backend": "node scripts/mobile/check-backend.mjs",
    "mobile:test": "node --import tsx --test tests/mobile/*.test.ts",
    "mobile:assets": "capacitor-assets generate --assetPath resources/raydar-v5 --ios --android --iconBackgroundColor '#F0BC18' --iconBackgroundColorDark '#F0BC18' --splashBackgroundColor '#FFFCF5' --splashBackgroundColorDark '#FFFCF5'"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/geolocation": "^8.2.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/network": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@fontsource/inter": "^5.3.0",
    "@opentelemetry/api": "^1.9.0",
    "@turf/boolean-point-in-polygon": "^7.3.4",
    "@turf/convex": "^7.3.4",
    "@types/canvas-confetti": "^1.9.0",
    "autoprefixer": "^10.4.24",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "firebase": "^12.9.0",
    "firebase-admin": "^13.6.1",
    "geofire-common": "6.0.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^0.563.0",
    "next": "16.1.6",
    "papaparse": "^5.5.3",
    "postcss": "^8.5.6",
    "qrcode": "1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-leaflet": "^5.0.0",
    "react-leaflet-cluster": "^4.0.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/leaflet": "^1.9.21",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "playwright": "^1.58.2",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
